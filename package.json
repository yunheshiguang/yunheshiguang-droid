{
  "name": "yunheshiguang",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./sdk": "./src/app/sdk/index.ts",
    "./sdk/testing": "./src/app/sdk/testing.ts"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "prepare": "buf generate",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build",
    "check:lines": "node scripts/check-source-lines.mjs",
    "check:fsd": "steiger ./src",
    "check:imports": "node scripts/check-imports.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:unused": "knip",
    "check:comments": "ast-grep scan",
    "check:distributions": "node scripts/check-distributions.mjs",
    "proto:generate": "buf generate",
    "proto:openapi": "buf generate --template buf.gen.openapi.yaml",
    "proto:lint": "buf lint",
    "proto:verify": "pnpm proto:lint && pnpm proto:openapi && git diff --exit-code -- src-tauri/src/workspace/api/openapi && cargo check --workspace --locked",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "pnpm run lint && pnpm run check:comments && pnpm run check:lines && pnpm run check:fsd && pnpm run check:imports && pnpm run check:unused && pnpm run check:contract && vitest run",
    "test:watch": "vitest",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "lint:deps": "cargo deny --locked check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-web": "^2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "i18next": "^26.5.6",
    "lucide-react": "^1.61.0",
    "partial-json": "^0.1.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@babel/core": "^8.0.7",
    "@biomejs/biome": "2.6.2",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.42.1",
    "steiger": "^0.8.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
